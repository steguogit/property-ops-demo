# ---------------------------------------------------------------------------
# MongoDB Atlas connection
# ---------------------------------------------------------------------------
# Standard SRV connection string from Atlas (Database > Connect > Drivers).
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"

# Database + collection used for the demo corpus.
MONGODB_DB="property_ops_demo"
MONGODB_COLLECTION="chunks"

# Iteration-2 collections (document lifecycle / ingestion / corrections).
# Defaults shown; override only if you need to.
MONGODB_DOCUMENTS_COLLECTION="documents"
MONGODB_ALIASES_COLLECTION="property_aliases"
MONGODB_VERSIONS_COLLECTION="document_versions"
MONGODB_CORRECTIONS_COLLECTION="user_corrections"
MONGODB_INGESTION_JOBS_COLLECTION="ingestion_jobs"
# GridFS bucket storing original uploaded files (for content preview).
MONGODB_FILE_BUCKET="original_files"

# Names of the Atlas indexes the app expects (must match create-indexes.ts).
ATLAS_VECTOR_INDEX="vector_index"
ATLAS_SEARCH_INDEX="lexical_index"
# Secondary vector index for the voyage-multimodal-3.5 comparison model.
ATLAS_VECTOR_INDEX_MM="vector_index_mm"

# ---------------------------------------------------------------------------
# Ingestion / OCR (iteration 2)
# ---------------------------------------------------------------------------
# Tesseract OCR languages for scanned images (EN + Traditional + Simplified).
OCR_LANGS="eng+chi_tra+chi_sim"
# OCR engine for scanned pages:
#   tesseract — local, free, no models to download (default; weaker on CJK)
#   onnx      — local PaddleOCR PP-OCRv4 via ONNX runtime (best CJK accuracy)
#   vision    — LLM vision (most accurate, but costly/slow at scale)
OCR_ENGINE="tesseract"
# Optional: override the PaddleOCR ONNX models dir (defaults to the bundled
# @gutenye/ocr-models assets).
# ONNX_OCR_MODELS_DIR=""
# OCR scanned PDFs on upload so text is keyword-searchable (true) or defer (false).
PDF_OCR_ON_UPLOAD="true"
# Max pages to OCR per scanned PDF (bounds latency).
PDF_OCR_MAX_PAGES="50"
# Below this many extracted characters, a file is treated as image-heavy /
# scanned and OCR (+ optional LLM-vision) is triggered.
OCR_MIN_CHARS="40"
# Set to "false" to disable the LLM-vision fallback for image transcription
# even when an LLM key is configured. Requires a vision-capable LLM model.
LLM_VISION="true"

# ---------------------------------------------------------------------------
# Voyage AI - embeddings only if EMBEDDING_STRATEGY=voyage
# https://www.voyageai.com/  (key starts with "pa-")
# NOTE: personal Voyage free-tier keys are limited to 3 RPM / 10K TPM and will
# return 429 under demo load. Reranking no longer uses this key (see below).
# ---------------------------------------------------------------------------
VOYAGE_API_KEY="pa-..."
VOYAGE_EMBED_MODEL="voyage-3"
VOYAGE_EMBED_DIM="1024"
VOYAGE_RERANK_MODEL="rerank-2.5"

# ---------------------------------------------------------------------------
# Reranker endpoint — "Voyage AI by MongoDB" (Atlas Model API), used by the
# "Vector + Reranker" retrieval mode. This is Voyage-API-compatible but routes
# through MongoDB's Atlas-hosted gateway with proper usage-tier rate limits,
# avoiding the personal Voyage free-tier 429s.
#   - ATLAS_MODEL_API_KEY: Atlas Model API key (starts with "al-"). Create/manage
#     it in Atlas > (Voyage AI by MongoDB) Model API Keys.
#   - RERANK_BASE_URL: gateway base URL (default shown). The client POSTs to
#     "${RERANK_BASE_URL}/rerank".
# If ATLAS_MODEL_API_KEY is unset, the reranker falls back to VOYAGE_API_KEY.
# ---------------------------------------------------------------------------
ATLAS_MODEL_API_KEY="al-..."
RERANK_BASE_URL="https://ai.mongodb.com/v1"

# ---------------------------------------------------------------------------
# Embedding strategy:
#   "atlas"  = Atlas Automatic Embedding (DEFAULT, recommended).
#              Atlas embeds chunkText on every insert/update AND embeds query
#              strings at search time. Editing a record auto-updates its vector
#              with NO re-seed. Requires a voyage-4 family model.
#   "voyage" = explicit Voyage embeddings written by the seed script. You must
#              re-run `npm run seed` after every data change.
# Switching strategies requires `npm run reindex` (rebuild) then `npm run seed`.
# ---------------------------------------------------------------------------
EMBEDDING_STRATEGY="atlas"
# Atlas auto-embedding model (voyage-4 family only:
# voyage-4 | voyage-4-lite | voyage-4-large | voyage-code-3).
ATLAS_AUTOEMBED_MODEL="voyage-4"

# ---------------------------------------------------------------------------
# Secondary (multimodal) embedding model — for the "Model comparison" feature.
# voyage-multimodal-3.5 vectors are generated client-side via the Atlas Model
# API gateway (same ATLAS_MODEL_API_KEY / RERANK_BASE_URL as the reranker) and
# stored in the `embeddingMultimodal` field, indexed by ATLAS_VECTOR_INDEX_MM.
# This lets you A/B the vector-search ranking of voyage-4 vs voyage-multimodal.
# Set MULTIMODAL_EMBED_ENABLED=false to disable the whole feature.
# ---------------------------------------------------------------------------
MULTIMODAL_EMBED_ENABLED="true"
MULTIMODAL_EMBED_MODEL="voyage-multimodal-3.5"
MULTIMODAL_EMBED_DIM="1024"

# ---------------------------------------------------------------------------
# LLM for RAG (optional - extractive fallback if empty).
# Option A: Grove Azure API Management gateway (api-key header). LLM_* wins.
# ---------------------------------------------------------------------------
LLM_PROVIDER=grove
LLM_API_KEY=""
LLM_MODEL=gpt-5.5
LLM_BASE_URL=https://grove-gateway-prod.azure-api.net/grove-foundry-prod/openai/v1

# Option B: plain OpenAI-compatible (Bearer header). Used only if LLM_* unset.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# ---------------------------------------------------------------------------
# Signature comparison + document signature detection
# ---------------------------------------------------------------------------
MONGODB_SIGNATURES_COLLECTION="signatures"
ATLAS_SIGNATURE_VECTOR_INDEX="signature_vector_index"
# Cosine (Atlas vectorSearchScore) thresholds for match confidence banding.
SIGNATURE_MATCH_THRESHOLD="0.93"
SIGNATURE_REVIEW_THRESHOLD="0.88"

# ---------------------------------------------------------------------------
# Conversational RAG memory (chat history + semantic recall)
# ---------------------------------------------------------------------------
MONGODB_CONVERSATIONS_COLLECTION="conversations"
MONGODB_CONVERSATION_MESSAGES_COLLECTION="conversation_messages"
ATLAS_CONV_VECTOR_INDEX="conv_vector_index"
ATLAS_CONV_SEARCH_INDEX="conv_lexical_index"

# ---------------------------------------------------------------------------
# Knowledge Policy Layer collections + governance
# ---------------------------------------------------------------------------
MONGODB_FEEDBACK_COLLECTION="correction_feedback"
MONGODB_PROPOSALS_COLLECTION="correction_proposals"
MONGODB_POLICIES_COLLECTION="knowledge_policies"
MONGODB_POLICY_TRACES_COLLECTION="policy_application_traces"
MONGODB_POLICY_CONFLICTS_COLLECTION="policy_conflicts"
MONGODB_POLICY_SIMULATIONS_COLLECTION="policy_impact_simulations"
# Default tenant for single-tenant demo runs.
DEFAULT_TENANT_ID="default"
# When false (default), AI-generated proposals require human approval.
AUTO_APPROVE_AI_PROPOSALS="false"

# ---------------------------------------------------------------------------
# OCR models path override (defaults to the bundled @gutenye/ocr-models).
# ONNX_OCR_MODELS_DIR=""
